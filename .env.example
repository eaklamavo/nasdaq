# Copy to .env and fill in. Missing optional keys make the matching tools report "source unavailable".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

FINNHUB_API_KEY=
FRED_API_KEY=
NEWSAPI_KEY=
FMP_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact details
SEC_USER_AGENT=ndx-agent your.name@example.com
